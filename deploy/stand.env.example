# Переменные контейнера на стенде (только имена и несекретные значения).
# Секреты (SESSION_SECRET, DEMO_OTP_CODE) передаются отдельным защищённым каналом и кладутся в /srv/sport/.env (права 600).
PUBLIC_BASE_URL=https://sport.tenderguru.io
ALLOW_STUB_IN_PRODUCTION=1
TRUST_PROXY=1
DEMO_OTP_PHONES=+37360000001,+37360000002,+37360000003,+37360000004
LOG_LEVEL=info
BACKUP_KEEP=14
# секреты, значения не в репозитории:
SESSION_SECRET=
DEMO_OTP_CODE=
