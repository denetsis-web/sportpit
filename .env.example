# Скопируйте в .env и впишите значения. Здесь только имена, значений нет.
# Пустое значение = «по умолчанию» (заглушки оплаты и SMS, локальные папки).

# Общее
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
PUBLIC_BASE_URL=
# Адрес клиента за своим прокси: true, число прокси в цепочке или адрес/подсеть. Пусто = не доверять X-Forwarded-For
TRUST_PROXY=

# Папки и база (пути от корня репозитория)
DATABASE_PATH=
BACKUP_DIR=
BACKUP_KEEP=
UPLOADS_DIR=
FILE_STORAGE=

# Сессии (секрет для подписи cookie). В production обязателен: без него сервер не стартует
SESSION_SECRET=
# NODE_ENV=production с заглушками оплаты/SMS или без https:// в PUBLIC_BASE_URL не стартует.
# 1 = разрешить это осознанно (демо, стенд); для боя не ставить
ALLOW_STUB_IN_PRODUCTION=

# Только стенд: фиксированный код входа для перечисленных номеров (6 цифр; номера через запятую)
DEMO_OTP_CODE=
DEMO_OTP_PHONES=

# Оплата: PAYMENT_PROVIDER пусто или stub = заглушка
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Только для заглушки: paid, failed или pending
STUB_PAYMENT_OUTCOME=

# SMS: SMS_PROVIDER пусто или stub = в разработке код входа пишется в консоль сервера (в production не пишется)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
