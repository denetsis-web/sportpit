# Скопируйте в .env и впишите значения. Здесь только имена, значений нет.
# Пустое значение = «по умолчанию» (заглушки оплаты и SMS, локальные папки).

# Общее
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
PUBLIC_BASE_URL=

# Папки и база (пути от корня репозитория)
DATABASE_PATH=
BACKUP_DIR=
BACKUP_KEEP=
UPLOADS_DIR=
FILE_STORAGE=

# Сессии (секрет для подписи cookie)
SESSION_SECRET=

# Оплата: PAYMENT_PROVIDER пусто или stub = заглушка
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Только для заглушки: paid, failed или pending
STUB_PAYMENT_OUTCOME=

# SMS: SMS_PROVIDER пусто или stub = код входа пишется в консоль сервера
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
